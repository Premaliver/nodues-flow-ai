# ============================================
# Smart NoDues AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in values
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env  (Windows)

# Application
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Database - PostgreSQL (for production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nodues_db

# Database Pool Settings
DB_POOL_SIZE=10
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true
DB_MAX_OVERFLOW=20

# Server
HOST=0.0.0.0
PORT=5000

# CORS
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Mail (Brevo SMTP Transactional Gateway)
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-brevo-login@smtp-brevo.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_DEFAULT_SENDER="Smart NoDues AI <noreply@smartnodue.in>"

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100/hour
RATELIMIT_STORAGE_URL=memory://

# File Uploads
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=static/uploads
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp

# ============================================
# Enterprise SaaS & Tenant Isolation
# ============================================
TENANT_ID=tenant_sample_01
TENANT_SLUG=sample_university
UNIVERSITY_NAME="Sample University"
APP_NAME="Smart NoDues Enterprise"
SUPPORT_EMAIL=support@sample.edu

# ============================================
# Cryptographic Licensing & Control Plane
# ============================================
CONTROL_PLANE_URL=https://api.nodues.app
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
LICENSE_FILE_PATH=license.key
OFFLINE_GRACE_PERIOD_DAYS=15




